NEXT_PUBLIC_SITE_URL=https://woolim-site.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PC_WORKER_SECRET=
# Optional JSON map for distinct secrets, for example:
# {"becky-office-pc":"home-secret","woolim-office-pc":"office-secret"}
PC_WORKER_SECRETS=
# Set false only after every PC sends an ID and uses PC_WORKER_SECRETS.
PC_WORKER_ALLOW_LEGACY=true
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_ALLOW_NON_PRODUCTION=false
GEMINI_PROJECT_LABEL=woolimhome
GEMINI_REVIEW_MODEL=gemini-3.5-flash
GEMINI_DAILY_CALL_LIMIT=3
GEMINI_MONTHLY_CALL_LIMIT=30
GEMINI_DAILY_COST_LIMIT_USD=1
GEMINI_MONTHLY_COST_LIMIT_USD=10
# Conservative accounting defaults; replace only after verifying the selected model's official price.
GEMINI_INPUT_USD_PER_MILLION_TOKENS=1
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=10
# Required before GEMINI_ENABLED=true. Comma-separated customer, person,
# project, or company names that must never be sent to Gemini. Definite IDs
# and addresses are redacted automatically; an empty value blocks activation.
PII_REDACTION_TERMS=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:woolim@woolimcompany.kr
# 관리자 화면에 들어올 수 있는 구글 계정. 쉼표로 구분합니다.
# 운영에서 이 값이 비면 아무도 들어갈 수 없습니다.
ADMIN_EMAILS=miseong0928@gmail.com,selavento.geo@gmail.com
PARTNER_EMAILS=
CRON_SECRET=
NAVER_WORKS_CLIENT_ID=
NAVER_WORKS_CLIENT_SECRET=
NAVER_WORKS_REDIRECT_URI=https://woolim-site.vercel.app/api/admin/naver-works/callback
DRIVE_TOKEN_ENCRYPTION_KEY=
